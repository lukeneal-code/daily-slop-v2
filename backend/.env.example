ENV=local
API_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:5173"]

DATABASE_URL=postgresql+asyncpg://slop:slop@db:5432/slop
DATABASE_URL_SYNC=postgresql+psycopg://slop:slop@db:5432/slop

# Set FAKE_LLM=true to run the full pipeline against canned responses
# (no API credits burned). Required for CI and offline dev.
FAKE_LLM=true
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

NIGEL_MODEL=claude-sonnet-4-6
ELLE_MODEL=gpt-4o
STEVE_MODEL=grok-4
IMAGE_MODEL=dall-e-3

IMAGES_BUCKET=daily-slop-v2-images-prod
IMAGES_LOCAL_DIR=/var/slop/images
IMAGES_PUBLIC_BASE_URL=http://localhost:8000/images

LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_ENABLED=false

# Local-only convenience: when set, lets you POST /admin/generate
# with `Authorization: Bearer $ADMIN_DEV_TOKEN`. Prod uses OIDC instead.
ADMIN_DEV_TOKEN=dev-please-change

STEVE_QUOTA=0.25
